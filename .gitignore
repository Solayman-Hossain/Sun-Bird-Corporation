node_modules/
*/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets
.env
.env.*
!.env.example
!.env.*.example

# Build & Compiled Outputs
dist/
*/dist/
build/
*/build/
out/
*.tsbuildinfo

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Code Coverage
coverage/
*/coverage/
.nyc_output/
*.lcov

# Media, Uploads & Temporary Files
uploads/
*/uploads/
storage/
*/storage/
temp/
tmp/
*.tmp
*.bak
*copy.json

# Local Database & Cache Volumes
mongo_data/
redis_data/
dump.rdb
*.dump

# IDEs & Code Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
