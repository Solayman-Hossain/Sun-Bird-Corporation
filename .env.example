# ==============================================================================
# SUN BIRD CORPORATION - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env (root and/or backend/.env) and populate with your credentials.
# ==============================================================================

# ── Server & Environment ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
API_VERSION=v1

# ── Databases & Cache Stores ─────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/sunbird_erp
REDIS_URL=redis://localhost:6379

# ── JWT Authentication (Use 64-character high-entropy secret in production) ──
JWT_ACCESS_SECRET=your_jwt_access_token_secret_min_32_chars_long
JWT_REFRESH_SECRET=your_jwt_refresh_token_secret_min_32_chars_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Client URLs for CORS & Redirects ─────────────────────────────────────────
CLIENT_STOREFRONT_URL=http://localhost:3000
CLIENT_ERP_URL=http://localhost:3000/erp

# ── AWS S3 / MinIO Object Storage (Mushak-6.3 Tax Invoices, Product Catalogs) ─
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=sunbird-documents
S3_ENDPOINT=http://localhost:9000
S3_USE_PATH_STYLE=true

# ── Citizen NID Cryptographic Hashing (Salts & Pepper) ────────────────────────
NID_HASH_SALT=your_secure_nid_salt_here
NID_HASH_PEPPER=your_secure_nid_pepper_here

# ── Bangladesh Government Porichoy NID Verification Gateway ───────────────────
PORICHOY_API_KEY=your_porichoy_api_key_here
PORICHOY_API_URL=https://api.porichoy.bd/api/v2/verifications

# ── SMS Gateway (OTP Verification & Customer Notifications) ───────────────────
SMS_API_KEY=your_sms_gateway_api_key_here
SMS_API_URL=https://api.smsbd.net/v1/send

# ── SSLCOMMERZ Payment Gateway ───────────────────────────────────────────────
SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sslcommerz_store_password
SSLCOMMERZ_IS_SANDBOX=true

# ── Courier API Integrations (Pathao & Steadfast) ─────────────────────────────
PATHAO_CLIENT_ID=your_pathao_client_id
PATHAO_CLIENT_SECRET=your_pathao_client_secret
PATHAO_WEBHOOK_SECRET=your_pathao_webhook_secret
STEADFAST_API_KEY=your_steadfast_api_key
STEADFAST_SECRET_KEY=your_steadfast_secret_key
STEADFAST_WEBHOOK_SECRET=your_steadfast_webhook_secret

# ── Google Gemini AI Central Service ─────────────────────────────────────────
GEMINI_API_KEY=your_google_gemini_api_key_here
