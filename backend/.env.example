# Sun Bird Corporation Cloud ERP - Backend Environment Configuration Template

# Server
PORT=5000
NODE_ENV=development

# Databases
MONGODB_URI=mongodb://localhost:27017/sunbird_erp
REDIS_URL=redis://localhost:6379

# Authentication & Token Lifetimes
JWT_ACCESS_SECRET=sunbird_erp_development_access_token_secret_key_at_least_32_chars
JWT_REFRESH_SECRET=sunbird_erp_development_refresh_token_secret_key_at_least_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Client Applications
CLIENT_STOREFRONT_URL=http://localhost:3000
CLIENT_ERP_URL=http://localhost:3001

# AWS S3 / MinIO Cloud Storage (Photos, Manuals, Mushak-6.3 PDF)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=sunbird-documents
S3_ENDPOINT=
S3_USE_PATH_STYLE=false

# Citizen NID Cryptographic Hashing
NID_HASH_SALT=sunbird_nid_secure_salt_2026
NID_HASH_PEPPER=sunbird_nid_secret_pepper_2026

# Bangladesh Government Porichoy NID Verification Gateway
PORICHOY_API_KEY=
PORICHOY_API_URL=https://api.porichoy.bd/api/v2/verifications

# SMS Gateway API (OTP Delivery & Customer Notifications)
SMS_API_KEY=
SMS_API_URL=https://api.smsbd.net/v1/send

# Optional AI CS Advisor
GEMINI_API_KEY=
